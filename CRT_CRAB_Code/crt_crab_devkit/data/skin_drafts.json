{
  "schema_id": "clawd.crt_tower.skin_manifest",
  "schema_version": 1,
  "status": "draft_for_codex_review_not_integrated",
  "project": "Clawd CRT Tower",
  "engine": "Godot 4.x",
  "rules": {
    "keep_clawd_original_body": true,
    "keep_body_color": "#D97757",
    "keep_body_geometry_and_limbs": true,
    "keep_collision_and_movement": true,
    "keep_puzzle_attack_logic": true,
    "only_change_weapon_attack_presentation_and_small_combat_reach": true,
    "no_status_effects_no_mobility_boosts": true,
    "all_skins_same_enemy_damage": 1,
    "one_attack_input": true,
    "no_pay_to_win": true
  },
  "existing_code_reference": {
    "primary_2d_controller": "res://scripts/side_crab.gd",
    "primary_2d_hit_handler": "res://scripts/side_world.gd",
    "existing_2d_attack_cooldown_s": 0.32,
    "existing_2d_hit_rect_half_extent_px": [
      31,
      23
    ],
    "existing_3d_controller": "res://scripts/crab_player.gd",
    "existing_3d_avatar": "res://scripts/crab_avatar.gd",
    "existing_2d_sprite_catalog": "res://data/cosmetics.json",
    "existing_sprite_frame_px": [
      32,
      32
    ],
    "sprite_columns": 8,
    "sprite_rows": 6,
    "note": "以上为仓库现状，配置数值是提案；优先接入屏幕内2D战斗。不要以这份数据覆写原版资源。"
  },
  "gacha": {
    "base_rarity_rates": {
      "common": 0.72,
      "rare": 0.25,
      "hidden": 0.03
    },
    "reuse_existing_rare_and_hidden_pity": true,
    "draw_order": "roll_rarity_with_existing_pity_then_uniform_skin_within_rarity",
    "capsule_visual_ids_by_rarity": {
      "common": [
        "cat",
        "dog"
      ],
      "rare": [
        "hamster",
        "rabbit",
        "bear"
      ],
      "hidden": [
        "hidden_cat"
      ]
    },
    "keep_capsule_appearance_separate_from_skin_reward": true,
    "duplicate_skin_award": "increment_duplicate_count_only_no_stats",
    "existing_pet_gacha_v1_save_must_be_preserved": true,
    "note": "目前扭蛋仅存6款动物收藏。Codex须在确认存档迁移与原子写入方案后接入8款皮肤，不得直接覆盖pet_gacha.json。"
  },
  "combat_contract": {
    "damage_per_hit": 1,
    "max_enemy_targets_per_attack": 1,
    "hit_area_origin": "player_facing_front",
    "enemy_hit_height_px": 23,
    "enemy_range_px_limit": [
      28,
      42
    ],
    "cooldown_s_limit": [
      0.32,
      0.42
    ],
    "projectile_types": [
      "short_projectile",
      "short_wave"
    ],
    "projectiles_can_target": [
      "normal_enemy"
    ],
    "projectiles_cannot_target": [
      "puzzle",
      "switch",
      "receiver",
      "door",
      "breakable",
      "story_trigger"
    ],
    "puzzle_hit_detection": "call_existing_vanilla_handler_once_only",
    "projectile_collision": "enemy_only_no_world_piercing",
    "status_effects": [],
    "movement_modifiers": {},
    "notes": [
      "攻速/射程参数为首轮试调值，保留玩家与谜题原判定",
      "即使视觉是音波或能量弹也必须有真实且与演出匹配的普通敌人命中判定",
      "不得将皮肤影响接到ChapterMechanics等解谜类脚本"
    ]
  },
